<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GetMaid</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    <style>
        :root {
            --gm-bg: #f0f2f6;
            --gm-surface: #ffffff;
            --gm-border: #e4e8ee;
            --gm-text: #0f1e35;
            --gm-muted: #6b778c;
            --gm-navy: #0c1224;
            --gm-navy-mid: #1a2744;
            --gm-amber: #f59e0b;
            --gm-amber-dark: #d97706;
            --gm-shadow: 0 1px 3px rgba(0,0,0,.06), 0 6px 20px rgba(0,0,0,.05);
            --gm-radius: 14px;
        }

        html, body {
            background: var(--gm-bg);
            font-family: 'DM Sans', system-ui, sans-serif;
            color: var(--gm-text);
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .gm-nav-wrap {
            max-width: 1200px;
            margin: 16px auto 12px;
            padding: 0 12px;
            width: 100%;
        }

        .gm-nav-shell {
            background: var(--gm-surface);
            border: 1px solid var(--gm-border);
            border-radius: var(--gm-radius);
            box-shadow: var(--gm-shadow);
            overflow: hidden;
        }

        .gm-navbar {
            background: linear-gradient(125deg, var(--gm-navy) 0%, var(--gm-navy-mid) 65%, #1f3561 100%);
            padding: 10px 14px;
        }

        .gm-brand {
            color: #fff !important;
            font-family: 'Nunito', sans-serif;
            font-weight: 800;
            letter-spacing: -.3px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .gm-brand-icon {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--gm-amber), var(--gm-amber-dark));
            color: #fff;
            box-shadow: 0 4px 10px rgba(245,158,11,.35);
            font-size: .95rem;
        }

        .gm-navbar .navbar-toggler {
            border-color: rgba(255,255,255,.35);
            background: rgba(255,255,255,.08);
        }

        .gm-navbar .navbar-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(255,255,255,.2);
        }

        .gm-navbar .nav-link {
            color: rgba(255,255,255,.88) !important;
            border-radius: 9px;
            padding: 7px 10px;
            font-size: .9rem;
            font-weight: 600;
            transition: all .18s ease;
        }

        .gm-navbar .nav-link:hover {
            color: #fff !important;
            background: rgba(255,255,255,.14);
        }

        .gm-navbar .nav-link.gm-active {
            background: rgba(245,158,11,.2);
            color: #fff !important;
            border: 1px solid rgba(245,158,11,.35);
        }

        .gm-inbox-link {
            background: rgba(16,185,129,.18);
            border: 1px solid rgba(16,185,129,.35);
        }

        .gm-right-pill {
            color: rgba(255,255,255,.88);
            font-size: .86rem;
            padding: 7px 10px;
            border-radius: 9px;
            background: rgba(255,255,255,.1);
            white-space: nowrap;
        }

        .gm-logout-link {
            color: #fecaca !important;
        }

        .gm-logout-link:hover {
            color: #fff !important;
            background: rgba(220,38,38,.28) !important;
        }

        .gm-admin-link {
            background: rgba(59,130,246,.2);
            border: 1px solid rgba(59,130,246,.35);
        }

        .gm-assumed-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: 8px;
            padding: 6px 9px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            color: #fff;
            background: rgba(220,38,38,.7);
            border: 1px solid rgba(254,202,202,.4);
        }

        .gm-return-btn {
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 9px;
            background: rgba(255,255,255,.08);
            color: #fff;
            font-size: .84rem;
            font-weight: 700;
            padding: 6px 10px;
            margin-left: 8px;
            transition: all .18s ease;
        }

        .gm-return-btn:hover {
            background: rgba(255,255,255,.15);
        }

        .gm-main {
            flex: 1;
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 0 12px 20px;
        }

        .gm-footer {
            border-top: 1px solid var(--gm-border);
            background: #fff;
            color: #7a8699;
            font-size: .86rem;
            padding: 14px 0;
            margin-top: 16px;
        }

        .gm-footer .container {
            max-width: 1200px;
        }
    </style>
</head>
<body>
<header>
    <div class="gm-nav-wrap">
        <div class="gm-nav-shell">
            <nav class="navbar navbar-expand-lg gm-navbar">
                <div class="container-fluid px-1">
                    <a class="navbar-brand gm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="gm-brand-icon"><i class="bi bi-house-heart-fill"></i></span>
                        <span>GetMaid</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gmNavbar"
                            aria-controls="gmNavbar" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="gmNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link gm-inbox-link" asp-controller="Message" asp-action="Inbox">
                                        <i class="bi bi-inbox-fill me-1"></i>Inbox
                                    </a>
                                </li>

                                @if (User.IsInRole("Customer"))
                                {
                                    <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Dashboard">Dashboard</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="WorkerShop">Find Workers</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="MyJobs">My Jobs</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="MyBookings">My Bookings</a></li>
                                }
                                else if (User.IsInRole("Worker"))
                                {
                                    <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="Dashboard">Dashboard</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="JobBoard">Job Board</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="MyBookings">My Bookings</a></li>
                                }

                                @if (User.IsInRole("Admin") || User.HasClaim(c => c.Type == "AssumedByAdminId"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link gm-admin-link" asp-controller="Admin" asp-action="AccountSwitcher">
                                            <i class="bi bi-person-switch me-1"></i>Account Switcher
                                        </a>
                                    </li>
                                }
                            }
                        </ul>

                        <ul class="navbar-nav align-items-lg-center">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <span class="gm-right-pill">
                                        <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                    </span>

                                    @if (User.HasClaim("IsAssumedSession", "true"))
                                    {
                                        <span class="gm-assumed-badge">
                                            <i class="bi bi-shield-exclamation"></i>Assumed
                                        </span>

                                        <form asp-controller="Admin" asp-action="ReturnToAdmin" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="gm-return-btn">Return</button>
                                        </form>
                                    }
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link gm-logout-link" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="RegisterCustomer">Customer Sign Up</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="RegisterWorker">Worker Sign Up</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </div>
</header>

<div class="gm-main">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="gm-footer">
    <div class="container">
        &copy; 2026 - GetMaid - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>