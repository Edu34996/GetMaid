@using Core.Concretes.Enums
@using System.Linq
@model Core.Concretes.DTOs.WorkerDashboardDTO

@{
    ViewData["Title"] = "Worker Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // --- Dropdown & Checkbox Data ---
    var allServiceTypes = Enum.GetValues(typeof(ServiceType)).Cast<ServiceType>().ToList();
    var allSkills = Enum.GetValues(typeof(Skill)).Cast<Skill>().ToList();
    var allAgeGroups = Enum.GetValues(typeof(AgeGroup)).Cast<AgeGroup>().ToList();
    var allWorkArrangements = Enum.GetValues(typeof(WorkArrangement)).Cast<WorkArrangement>().ToList();
    var allCommitments = Enum.GetValues(typeof(CommitmentPreference)).Cast<CommitmentPreference>().ToList();
    var allDays = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().OrderBy(d => d == DayOfWeek.Sunday ? 7 : (int)d).ToList();

    // --- Selected State ---
    var selectedServices = Model?.OfferedServices?.Select(x => x.ToString()).ToHashSet() ?? new HashSet<string>();
    var selectedSkills = Model?.Skills?.Select(x => x.ToString()).ToHashSet() ?? new HashSet<string>();
    var selectedAgeGroups = Model?.ExperiencedAgeGroups?.Select(x => x.ToString()).ToHashSet() ?? new HashSet<string>();
    var selectedDays = Model?.PreferredWorkDays?.Select(x => x.ToString()).ToHashSet() ?? new HashSet<string>();

    // --- Tag Columns Calculation (Fixes CS0103) ---
    int tagCols = 0;
    if (Model?.OfferedServices?.Any() == true) tagCols++;
    if (Model?.Skills?.Any() == true) tagCols++;
    if (Model?.ExperiencedAgeGroups?.Any() == true) tagCols++;
    if (Model?.LanguagesSpoken?.Any() == true) tagCols++;
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap" rel="stylesheet" />

<style>
/* =========================================================
   WORKER DASHBOARD – CUSTOM STYLES
   ========================================================= */
.wd-layout {
    margin-left: calc(-1 * var(--bs-gutter-x, 0px));
    margin-right: calc(-1 * var(--bs-gutter-x, 0px));
    margin-top: calc(-1 * var(--page-top-offset, 0px));
}

:root {
    --wd-sidebar-w: 264px;
    --wd-topbar-h: 60px;
    --wd-bg: #f0f2f6;
    --wd-surface: #ffffff;
    --wd-border: #e4e8ee;
    --wd-navy: #0c1224;
    --wd-navy-mid: #1a2744;
    --wd-amber: #f59e0b;
    --wd-amber-dark: #d97706;
    --wd-text-primary: #0f1e35;
    --wd-text-mid: #3f4d63;
    --wd-text-soft: #7a8699;
    --wd-radius-card: 16px;
    --wd-radius-sm: 10px;
    --wd-shadow-card: 0 1px 3px rgba(0,0,0,.06), 0 6px 20px rgba(0,0,0,.05);
    --wd-shadow-hover: 0 4px 20px rgba(0,0,0,.12);
    font-family: 'DM Sans', system-ui, sans-serif;
}

.wd-layout { display: flex; min-height: 100vh; background: var(--wd-bg); }
.wd-sidebar { position: fixed; inset-block: 0; left: 0; width: var(--wd-sidebar-w); background: var(--wd-navy); display: flex; flex-direction: column; z-index: 1050; transition: transform .28s cubic-bezier(.4,0,.2,1); overflow-y: auto; overflow-x: hidden; }

@@media (max-width: 991.98px) {
    .wd-sidebar { transform: translateX(-100%); }
    .wd-sidebar.open { transform: translateX(0); }
}

.wd-sidebar::-webkit-scrollbar { width: 4px; }
.wd-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 4px; }

.wd-brand { display: flex; align-items: center; gap: 10px; padding: 22px 20px 18px; border-bottom: 1px solid rgba(255,255,255,.07); }
.wd-brand-logo { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, var(--wd-amber), var(--wd-amber-dark)); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.05rem; flex-shrink: 0; box-shadow: 0 4px 12px rgba(245,158,11,.4); }
.wd-brand-name { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.05rem; color: #fff; letter-spacing: -.4px; line-height: 1; }
.wd-brand-name span { color: var(--wd-amber); }

.wd-sb-profile { padding: 16px 20px; display: flex; align-items: center; gap: 11px; border-bottom: 1px solid rgba(255,255,255,.07); }
.wd-sb-avatar, .wd-sb-avatar-ph { width: 42px; height: 42px; border-radius: 50%; border: 2px solid rgba(245,158,11,.4); flex-shrink: 0; }
.wd-sb-avatar { object-fit: cover; }
.wd-sb-avatar-ph { background: rgba(245,158,11,.18); display: flex; align-items: center; justify-content: center; color: var(--wd-amber); font-size: 1.25rem; }
.wd-sb-profile-info { min-width: 0; }
.wd-sb-name { display: block; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: .85rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.wd-nav { padding: 14px 12px; flex: 1; }
.wd-nav-section { font-size: .62rem; font-weight: 700; letter-spacing: 1.6px; color: rgba(255,255,255,.28); padding: 10px 8px 6px; }
.wd-nav-link { display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: var(--wd-radius-sm); color: rgba(255,255,255,.6); text-decoration: none !important; font-size: .855rem; font-weight: 500; margin-bottom: 1px; transition: background .18s, color .18s; position: relative; }
.wd-nav-link i { width: 18px; text-align: center; font-size: .95rem; flex-shrink: 0; }
.wd-nav-link span { flex: 1; }
.wd-nav-link:hover { background: rgba(255,255,255,.07); color: #fff; }
.wd-nav-link.active { background: rgba(245,158,11,.16); color: var(--wd-amber); border: 1px solid rgba(245,158,11,.22); }
.wd-nav-link.active i { color: var(--wd-amber); }
.wd-nav-link.danger { color: rgba(248,113,113,.7); }
.wd-nav-link.danger:hover { background: rgba(239,68,68,.1); color: #f87171; }

.wd-sb-close { background: none; border: none; color: rgba(255,255,255,.45); font-size: 1.1rem; cursor: pointer; padding: 2px; display: none; }
@@media (max-width: 991.98px) { .wd-sb-close { display: block; } }

.wd-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 1040; opacity: 0; visibility: hidden; transition: opacity .28s, visibility .28s; }
.wd-overlay.open { opacity: 1; visibility: visible; }

.wd-main { margin-left: var(--wd-sidebar-w); flex: 1; display: flex; flex-direction: column; min-height: 100vh; transition: margin-left .28s cubic-bezier(.4,0,.2,1); }
@@media (max-width: 991.98px) { .wd-main { margin-left: 0; } }

.wd-topbar { position: sticky; top: 0; height: var(--wd-topbar-h); background: var(--wd-surface); border-bottom: 1px solid var(--wd-border); display: flex; align-items: center; gap: 12px; padding: 0 24px; z-index: 200; }
.wd-topbar-toggle { background: none; border: none; color: var(--wd-text-mid); font-size: 1.35rem; cursor: pointer; padding: 2px; line-height: 1; display: none; }
@@media (max-width: 991.98px) { .wd-topbar-toggle { display: block; } }

.wd-breadcrumb { flex: 1; font-size: .825rem; color: var(--wd-text-soft); }
.wd-breadcrumb strong { color: var(--wd-text-primary); }

.wd-content { padding: 28px 28px 64px; flex: 1; }
@@media (max-width: 767.98px) { .wd-content { padding: 16px 14px 48px; } }

.wd-page-title { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.55rem; color: var(--wd-text-primary); letter-spacing: -.5px; margin: 0 0 4px; }
.wd-page-sub { color: var(--wd-text-soft); font-size: .855rem; margin: 0 0 24px; }

.wd-stat { background: var(--wd-surface); border-radius: var(--wd-radius-card); padding: 18px 20px; display: flex; align-items: center; gap: 14px; box-shadow: var(--wd-shadow-card); transition: transform .2s, box-shadow .2s; animation: fadeSlideUp .4s ease both; }
.wd-stat:hover { transform: translateY(-2px); box-shadow: var(--wd-shadow-hover); }
.wd-stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0; background: color-mix(in srgb, var(--icon-clr) 14%, transparent); color: var(--icon-clr); }
.wd-stat-val { display: block; font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.45rem; color: var(--wd-text-primary); line-height: 1; }
.wd-stat-val small { font-size: .68em; font-weight: 600; color: var(--wd-text-soft); }
.wd-stat-lbl { display: block; font-size: .73rem; color: var(--wd-text-soft); margin-top: 5px; }

.wd-card { background: var(--wd-surface); border-radius: var(--wd-radius-card); box-shadow: var(--wd-shadow-card); animation: fadeSlideUp .4s ease both; }
.wd-card-head { display: flex; align-items: center; gap: 10px; padding: 16px 20px 14px; border-bottom: 1px solid var(--wd-border); }
.wd-card-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .88rem; flex-shrink: 0; background: color-mix(in srgb, var(--icon-clr) 13%, transparent); color: var(--icon-clr); }
.wd-card-title { font-family: 'Nunito', sans-serif; font-weight: 700; font-size: .875rem; color: var(--wd-text-primary); margin: 0; letter-spacing: -.2px; }
.wd-card-body { padding: 18px 20px; }

.wd-head-actions { margin-left: auto; display: flex; gap: 8px; }
.wd-edit-btn { border: none; background: #f1f5f9; border: 1px solid var(--wd-border); color: var(--wd-text-mid); width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; transition: all .2s; }
.wd-edit-btn:hover { background: var(--wd-amber); color: #fff; border-color: var(--wd-amber); }

.wd-profile-card { background: var(--wd-surface); border-radius: var(--wd-radius-card); box-shadow: var(--wd-shadow-card); overflow: hidden; text-align: center; animation: fadeSlideUp .4s ease .05s both; }
.wd-profile-banner { height: 90px; background: linear-gradient(125deg, var(--wd-navy) 0%, var(--wd-navy-mid) 60%, #1f3561 100%); position: relative; }
.wd-profile-body { padding: 0 22px 22px; }
.wd-profile-av, .wd-profile-av-ph { width: 82px; height: 82px; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 4px 16px rgba(0,0,0,.14); margin: -41px auto 12px; position: relative; z-index: 1; }
.wd-profile-av { display: block; object-fit: cover; }
.wd-profile-av-ph { background: linear-gradient(135deg, var(--wd-amber), var(--wd-amber-dark)); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2.1rem; }
.wd-profile-name { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.2rem; color: var(--wd-text-primary); margin: 0 0 3px; }
.wd-profile-email { color: var(--wd-text-soft); font-size: .8rem; margin: 0 0 14px; }
.wd-stars { display: inline-flex; align-items: center; gap: 2px; margin-bottom: 12px; }
.wd-star { color: #d1d5db; font-size: .95rem; }
.wd-star.on { color: var(--wd-amber); }
.wd-stars-count { color: var(--wd-text-soft); font-size: .75rem; margin-left: 5px; }

.wd-info-list { display: flex; flex-direction: column; gap: 12px; }
.wd-info-row { display: flex; align-items: flex-start; gap: 10px; }
.wd-info-ico { width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--wd-border); background: #f8fafc; display: flex; align-items: center; justify-content: center; font-size: .78rem; color: var(--wd-text-mid); flex-shrink: 0; margin-top: 2px; }
.wd-info-lbl { display: block; font-size: .67rem; font-weight: 600; text-transform: uppercase; letter-spacing: .6px; color: var(--wd-text-soft); }
.wd-info-val { display: block; font-size: .85rem; font-weight: 500; color: var(--wd-text-primary); margin-top: 1px; }

.wd-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.wd-tag { display: inline-block; padding: 4px 11px; border-radius: 20px; font-size: .73rem; font-weight: 600; white-space: nowrap; }
.wd-tag-blue { background: #dbeafe; color: #1d4ed8; }
.wd-tag-indigo { background: #e0e7ff; color: #4338ca; }
.wd-tag-amber { background: #fef3c7; color: #b45309; }
.wd-tag-teal { background: #d1fae5; color: #047857; }

.wd-days { display: flex; flex-wrap: wrap; gap: 8px; }
.wd-day { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .2px; background: #f1f5f9; color: #94a3b8; border: 2px solid transparent; }
.wd-day.on { background: linear-gradient(135deg, var(--wd-amber), var(--wd-amber-dark)); color: #fff; box-shadow: 0 4px 12px rgba(245,158,11,.36); }

.wd-video { width: 100%; max-height: 420px; border-radius: 12px; background: #000; display: block; }
.wd-bio { line-height: 1.72; color: var(--wd-text-mid); font-size: .885rem; margin: 0; }

.wd-alert-ok { border-radius: 12px; background: #f0fdf4; border: 1.5px solid #bbf7d0; color: #15803d; font-size: .86rem; }
.wd-alert-err { border-radius: 12px; background: #fef2f2; border: 1.5px solid #fecaca; color: #dc2626; font-size: .86rem; }

.wd-label { display: block; font-size: .8rem; font-weight: 700; color: var(--wd-text-mid); margin-bottom: 6px; }
.wd-input { width: 100%; padding: 10px 14px; border: 1.5px solid var(--wd-border); border-radius: var(--wd-radius-sm); font-size: .875rem; font-family: 'DM Sans', sans-serif; color: var(--wd-text-primary); background: #f8fafc; outline: none; transition: all .2s; }
.wd-input:focus { border-color: var(--wd-amber); background: #fff; box-shadow: 0 0 0 3px rgba(245,158,11,.14); }
textarea.wd-input { resize: vertical; min-height: 110px; }

.wd-checkbox-wrap { display: flex; align-items: center; gap: 9px; cursor: pointer; }
.wd-checkbox-wrap input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--wd-amber); cursor: pointer; border-radius: 4px; flex-shrink: 0; }
.wd-checkbox-wrap span { font-size: .875rem; font-weight: 500; color: var(--wd-text-mid); }

.wd-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 20px; text-align: center; color: var(--wd-text-soft); }
.wd-chipbox { display: flex; flex-wrap: wrap; gap: 8px; padding: 8px; border: 1.5px solid var(--wd-border); border-radius: 10px; background: #f8fafc; min-height: 48px; }
.wd-chip { background: #e2e8f0; border-radius: 20px; padding: 5px 12px; font-size: .8rem; font-weight: 600; display: inline-flex; gap: 6px; align-items: center; color: var(--wd-text-primary); }
.wd-chip button { border: none; background: transparent; color: #64748b; padding: 0 2px; font-size: 1rem; line-height: 1; cursor: pointer; }
.wd-chip button:hover { color: #ef4444; }

@@keyframes fadeSlideUp { from { opacity: 0; transform: translateY(14px);} to {opacity: 1; transform: translateY(0);} }
</style>

<div class="wd-layout">
    @* --- SIDEBAR --- *@
    <aside class="wd-sidebar" id="wdSidebar">
        <div class="wd-brand">
            <div class="wd-brand-logo"><i class="bi bi-house-heart-fill"></i></div>
            <span class="wd-brand-name">Worker<span>Hub</span></span>
            <button class="wd-sb-close ms-auto" id="sbClose" aria-label="Close sidebar"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="wd-sb-profile">
            @if (!string.IsNullOrWhiteSpace(Model?.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="wd-sb-avatar" alt="@Model.FirstName" />
            }
            else
            {
                <div class="wd-sb-avatar-ph"><i class="bi bi-person-fill"></i></div>
            }
            <div class="wd-sb-profile-info">
                <span class="wd-sb-name">@(Model?.FirstName ?? "Worker")</span>
            </div>
        </div>

        <nav class="wd-nav" id="wdNav">
            <p class="wd-nav-section">MAIN</p>
            <a class="wd-nav-link active" href="@Url.Action("Dashboard", "Worker")"><i class="bi bi-grid-1x2-fill"></i><span>Overview</span></a>
            <a class="wd-nav-link" href="@Url.Action("MyBookings", "Worker")"><i class="bi bi-calendar2-check-fill"></i><span>My Bookings</span></a>
            <a class="wd-nav-link" href="@Url.Action("JobBoard", "Worker")"><i class="bi bi-briefcase-fill"></i><span>Job Board</span></a>
            <p class="wd-nav-section">ACCOUNT</p>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="wd-nav-link danger" style="border:none;background:none;width:100%;text-align:left;padding:9px 12px;">
                    <i class="bi bi-box-arrow-right"></i><span>Sign Out</span>
                </button>
            </form>
        </nav>
    </aside>

    <div class="wd-overlay" id="wdOverlay"></div>

    @* --- MAIN CONTENT --- *@
    <div class="wd-main">
        <header class="wd-topbar">
            <button class="wd-topbar-toggle" id="sbToggle" aria-label="Open sidebar"><i class="bi bi-list"></i></button>
            <div class="wd-breadcrumb"><span>Worker</span><i class="bi bi-chevron-right mx-2" style="font-size:.65rem;"></i><strong>Overview</strong></div>
        </header>

        <main class="wd-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert wd-alert-ok alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert wd-alert-err alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model == null)
            {
                <div class="wd-empty"><i class="bi bi-person-x"></i><h4>No Profile Data</h4><p>Please complete your profile setup to get started.</p></div>
            }
            else
            {
                <h1 class="wd-page-title">Good to see you, @Model.FirstName</h1>
                <p class="wd-page-sub">Here is a summary of your profile and activity. Click the edit icons to update your information.</p>

                @* ── SINGLE FORM WRAPPER FOR ALL MODALS ── *@
                <form asp-controller="Worker" asp-action="UpdateProfile" method="post" id="profileForm">
                    @Html.AntiForgeryToken()

                    @* STATS ROW *@
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3"><div class="wd-stat"><div class="wd-stat-icon" style="--icon-clr:#f59e0b"><i class="bi bi-star-fill"></i></div><div><span class="wd-stat-val">@Model.AverageRating.ToString("0.0")</span><span class="wd-stat-lbl">Avg. Rating</span></div></div></div>
                        <div class="col-6 col-md-3"><div class="wd-stat"><div class="wd-stat-icon" style="--icon-clr:#6366f1"><i class="bi bi-chat-quote-fill"></i></div><div><span class="wd-stat-val">@Model.TotalReviews</span><span class="wd-stat-lbl">Total Reviews</span></div></div></div>
                        <div class="col-6 col-md-3"><div class="wd-stat"><div class="wd-stat-icon" style="--icon-clr:#10b981"><i class="bi bi-calendar2-week-fill"></i></div><div><span class="wd-stat-val">@(Model.ExperienceYears.ToString() ?? "—")<small> yr</small></span><span class="wd-stat-lbl">Experience</span></div></div></div>
                        <div class="col-6 col-md-3"><div class="wd-stat"><div class="wd-stat-icon" style="--icon-clr:#3b82f6"><i class="bi bi-currency-dollar"></i></div><div><span class="wd-stat-val">@(Model.MinHourlyRate?.ToString("$0") ?? "—")<small>/hr</small></span><span class="wd-stat-lbl">Min. Rate</span></div></div></div>
                    </div>

                    @* MAIN PROFILE GRID *@
                    <div class="row g-4 mb-4">
                        
                        @* Profile Overview Card *@
                        <div class="col-lg-4">
                            <div class="wd-profile-card h-100">
                                <div class="wd-profile-banner"></div>
                                <div class="wd-profile-body">
                                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)) { <img src="@Model.ProfilePictureUrl" class="wd-profile-av" alt="@Model.FirstName" /> }
                                    else { <div class="wd-profile-av-ph"><i class="bi bi-person-fill"></i></div> }
                                    <h3 class="wd-profile-name">@Model.FirstName</h3>
                                    <p class="wd-profile-email">@Model.Email</p>
                                    <div class="wd-stars mt-2">
                                        @for (int s = 1; s <= 5; s++){ <i class="bi bi-star@(s <= Math.Round(Model.AverageRating) ? "-fill" : "") wd-star@(s <= Math.Round(Model.AverageRating) ? " on" : "")"></i> }
                                        <span class="wd-stars-count">(@Model.TotalReviews)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Basic Information Card *@
                        <div class="col-lg-4">
                            <div class="wd-card h-100">
                                <div class="wd-card-head">
                                    <span class="wd-card-icon" style="--icon-clr:#6366f1"><i class="bi bi-person-lines-fill"></i></span>
                                    <h6 class="wd-card-title">Basic Info</h6>
                                    <div class="wd-head-actions"><button type="button" class="wd-edit-btn" data-bs-toggle="modal" data-bs-target="#basicInfoModal" title="Edit Basic Info"><i class="bi bi-pencil-square"></i></button></div>
                                </div>
                                <div class="wd-card-body">
                                    <div class="wd-info-list">
                                        <div class="wd-info-row"><span class="wd-info-ico"><i class="bi bi-telephone-fill"></i></span><div><span class="wd-info-lbl">Phone</span><span class="wd-info-val">@(Model.PhoneNumber ?? "Not provided")</span></div></div>
                                        <div class="wd-info-row"><span class="wd-info-ico"><i class="bi bi-geo-alt-fill"></i></span><div><span class="wd-info-lbl">City</span><span class="wd-info-val">@(Model.City ?? "—")</span></div></div>
                                        <div class="wd-info-row"><span class="wd-info-ico"><i class="bi bi-wind"></i></span><div><span class="wd-info-lbl">Smoker</span><span class="wd-info-val">@(Model.IsSmoker ? "Yes" : "No")</span></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Work Preferences Card *@
                        <div class="col-lg-4">
                            <div class="wd-card h-100">
                                <div class="wd-card-head">
                                    <span class="wd-card-icon" style="--icon-clr:#f59e0b"><i class="bi bi-sliders"></i></span>
