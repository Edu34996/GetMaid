@using Core.Concretes.Enums
@model Core.Concretes.DTOs.WorkerDashboardDTO

@{
    ViewData["Title"] = "Worker Dashboard";
}

<h1>Worker Dashboard</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success border border-success p-2 mb-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model != null)
{
    <div class="border rounded p-3 mb-4">
        <h3>Current Profile</h3>

        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
        {
            <div class="mb-3">
                <img src="@Model.ProfilePictureUrl"
                     alt="@Model.FirstName"
                     style="max-width: 180px; max-height: 180px; object-fit: cover;" />
            </div>
        }

        <p><strong>Name:</strong> @Model.FirstName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
        <p><strong>Bio:</strong> @Model.Bio</p>
        <p><strong>Smoker:</strong> @(Model.IsSmoker ? "Yes" : "No")</p>
        <p><strong>City:</strong> @Model.City</p>
        <p><strong>Min Hourly Rate:</strong> @(Model.MinHourlyRate?.ToString("0.00") ?? "-")</p>
        <p><strong>Max Hourly Rate:</strong> @(Model.MaxHourlyRate?.ToString("0.00") ?? "-")</p>
        <p><strong>Experience Years:</strong> @Model.ExperienceYears</p>
        <p><strong>Introduction Video:</strong> @(string.IsNullOrWhiteSpace(Model.IntroductionVideoUrl) ? "-" : Model.IntroductionVideoUrl)</p>
        <p><strong>Identity Verification:</strong> @Model.IdentityVerificationStatus</p>
        <p><strong>Preferred Arrangement:</strong> @Model.PreferredArrangement</p>
        <p><strong>Commitment Preference:</strong> @Model.CommitmentPreference</p>
        <p><strong>Max Days/Week:</strong> @(Model.MaxDaysPerWeek?.ToString() ?? "-")</p>
        <p><strong>Max Hours/Day:</strong> @(Model.MaxHoursPerDay?.ToString() ?? "-")</p>
        <p><strong>Average Rating:</strong> @Model.AverageRating</p>
        <p><strong>Total Reviews:</strong> @Model.TotalReviews</p>

        <div class="mt-3">
            <strong>Offered Services:</strong><br />
            @if (Model.OfferedServices != null && Model.OfferedServices.Any())
            {
                @foreach (var service in Model.OfferedServices)
                {
                    <span class="badge bg-secondary me-1">@service</span>
                }
            }
            else
            {
                <span>None listed</span>
            }
        </div>

        <div class="mt-3">
            <strong>Skills:</strong><br />
            @if (Model.Skills != null && Model.Skills.Any())
            {
                @foreach (var skill in Model.Skills)
                {
                    <span class="badge bg-info text-dark me-1">@skill</span>
                }
            }
            else
            {
                <span>None listed</span>
            }
        </div>

        <div class="mt-3">
            <strong>Experienced Age Groups:</strong><br />
            @if (Model.ExperiencedAgeGroups != null && Model.ExperiencedAgeGroups.Any())
            {
                @foreach (var ageGroup in Model.ExperiencedAgeGroups)
                {
                    <span class="badge bg-warning text-dark me-1">@ageGroup</span>
                }
            }
            else
            {
                <span>None listed</span>
            }
        </div>

        <div class="mt-3">
            <strong>Languages Spoken:</strong><br />
            @if (Model.LanguagesSpoken != null && Model.LanguagesSpoken.Any())
            {
                @foreach (var language in Model.LanguagesSpoken)
                {
                    <span class="badge bg-light text-dark border me-1">@language</span>
                }
            }
            else
            {
                <span>None listed</span>
            }
        </div>

        <div class="mt-3">
            <strong>Preferred Work Days:</strong><br />
            @if (Model.PreferredWorkDays != null && Model.PreferredWorkDays.Any())
            {
                @foreach (var day in Model.PreferredWorkDays)
                {
                    <span class="badge bg-dark me-1">@day</span>
                }
            }
            else
            {
                <span>None listed</span>
            }
        </div>
    </div>
}

<div class="border rounded p-3">
    <h3>Update Profile</h3>
    <p class="text-muted">
        This form updates only editable worker profile fields supported by your current update action.
    </p>

    <form asp-controller="Worker" asp-action="UpdateProfile" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Bio</label>
            <textarea name="Bio" rows="4" class="form-control">@Model?.Bio</textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">City</label>
            <input type="text" name="City" value="@Model?.City" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Minimum Hourly Rate</label>
            <input type="number" step="0.01" name="MinHourlyRate" value="@Model?.MinHourlyRate" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Maximum Hourly Rate</label>
            <input type="number" step="0.01" name="MaxHourlyRate" value="@Model?.MaxHourlyRate" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Introduction Video URL</label>
            <input type="text" name="IntroductionVideoUrl" value="@Model?.IntroductionVideoUrl" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" name="IsSmoker" value="true" class="form-check-input" @(Model != null && Model.IsSmoker ? "checked" : "") />
            <label class="form-check-label">Are you a smoker?</label>
        </div>

        <button type="submit" class="btn btn-primary">Update Profile</button>
    </form>
</div>