<script>
(function () {
    const sidebar = document.getElementById('wdSidebar');
    const overlay = document.getElementById('wdOverlay');
    const toggle = document.getElementById('sbToggle');
    const close = document.getElementById('sbClose');

    function openSb(){ sidebar && sidebar.classList.add('open'); overlay && overlay.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function shutSb(){ sidebar && sidebar.classList.remove('open'); overlay && overlay.classList.remove('open'); document.body.style.overflow = ''; }

    toggle && toggle.addEventListener('click', openSb);
    close && close.addEventListener('click', shutSb);
    overlay && overlay.addEventListener('click', shutSb);

    // --- Language autocomplete + typo correction ---
    const commonLanguages = [
        "English","Spanish","French","German","Italian","Portuguese","Arabic","Hindi","Urdu","Bengali","Mandarin","Cantonese",
        "Japanese","Korean","Russian","Turkish","Dutch","Swedish","Norwegian","Danish","Polish","Ukrainian","Greek","Hebrew",
        "Persian","Vietnamese","Thai","Malay","Indonesian","Tagalog","Swahili","Yoruba","Igbo","Hausa","Amharic","Somali"
    ];

    const languageInput = document.getElementById('languageInput');
    const languageSuggestions = document.getElementById('languageSuggestions');
    const addLanguageBtn = document.getElementById('addLanguageBtn');
    const chipsBox = document.getElementById('languageChips');
    const hiddenInputsBox = document.getElementById('languageHiddenInputs');

    function norm(v){ return (v || '').trim().toLowerCase(); }

    function toTitleCase(str){
        return str.toLowerCase().split(' ').filter(Boolean).map(w => w[0].toUpperCase() + w.slice(1)).join(' ');
    }

    function levenshtein(a,b){
        a = norm(a); b = norm(b);
        if (!a.length) return b.length;
        if (!b.length) return a.length;
        const m = Array.from({length:a.length+1}, () => []);
        for (let i=0;i<=a.length;i++) m[i][0]=i;
        for (let j=0;j<=b.length;j++) m[0][j]=j;
        for (let i=1;i<=a.length;i++){
            for (let j=1;j<=b.length;j++){
                const cost = a[i-1] === b[j-1] ? 0 : 1;
                m[i][j] = Math.min(m[i-1][j]+1, m[i][j-1]+1, m[i-1][j-1]+cost);
            }
        }
        return m[a.length][b.length];
    }

    function bestLanguageMatch(input){
        const n = norm(input);
        if (!n) return "";
        let best = "";
        let bestScore = 999;
        for (const lang of commonLanguages){
            const d = levenshtein(n, lang);
            if (d < bestScore){ bestScore = d; best = lang; }
        }
        if (bestScore <= 2 || best.toLowerCase().startsWith(n) || n.startsWith(best.toLowerCase())) return best;
        return toTitleCase(input);
    }

    function refreshSuggestions(){
        if (!languageSuggestions) return;
        languageSuggestions.innerHTML = "";
        commonLanguages.forEach(l => {
            const opt = document.createElement("option");
            opt.value = l;
            languageSuggestions.appendChild(opt);
        });
    }

    function getCurrentLangSet(){
        const set = new Set();
        hiddenInputsBox.querySelectorAll('input[name="LanguagesSpoken"]').forEach(i => set.add(norm(i.value)));
        return set;
    }

    function addLanguage(raw){
        const fixed = bestLanguageMatch(raw);
        if (!fixed) return;
        const set = getCurrentLangSet();
        if (set.has(norm(fixed))) return;

        const chip = document.createElement('span');
        chip.className = 'wd-chip';
        chip.setAttribute('data-lang', fixed);
        chip.innerHTML = fixed + ' <button type="button" class="remove-lang">&times;</button>';
        chipsBox.appendChild(chip);

        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'LanguagesSpoken';
        hidden.value = fixed;
        hiddenInputsBox.appendChild(hidden);
    }

    addLanguageBtn && addLanguageBtn.addEventListener('click', function(){
        addLanguage(languageInput.value);
        languageInput.value = '';
        languageInput.focus();
    });

    languageInput && languageInput.addEventListener('keydown', function(e){
        if (e.key === 'Enter'){ e.preventDefault(); addLanguage(languageInput.value); languageInput.value = ''; }
    });

    chipsBox && chipsBox.addEventListener('click', function(e){
        const btn = e.target.closest('.remove-lang');
        if (!btn) return;
        const chip = btn.closest('.wd-chip');
        if (!chip) return;
        const lang = chip.getAttribute('data-lang');
        chip.remove();

        const inputs = hiddenInputsBox.querySelectorAll('input[name="LanguagesSpoken"]');
        for (const i of inputs){
            if (norm(i.value) === norm(lang)){ i.remove(); break; }
        }
    });

    refreshSuggestions();
})();
</script>