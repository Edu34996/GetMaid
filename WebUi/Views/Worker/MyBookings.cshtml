@model IEnumerable<Core.Concretes.DTOs.BookingDTO>

<h1>My Booking Requests</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 15px;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 15px;">
        @TempData["ErrorMessage"]
    </div>
}

<table border="1" cellpadding="5" cellspacing="0" style="width: 100%; text-align: left;">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Date Requested</th>
            <th>Duration</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.CustomerName</td>
                    <td>@booking.ScheduledDate.ToShortDateString()</td>
                    <td>@booking.DurationHours hours</td>
                    <td><strong>@booking.Status</strong></td>
                    <td>
                        <strong>@booking.Status</strong>
                        @if (booking.Status == "Confirmed")
                        {
                            <br /><br />
                            <a href="/Customer/LeaveReview?bookingId=@booking.Id&revieweeId=@booking.WorkerId" 
                               style="background-color: #ffc107; color: black; padding: 5px 10px; text-decoration: none; border-radius: 3px; font-size: 0.9em;">
                                Leave Review
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5">You have no booking requests at this time.</td></tr>
        }
    </tbody>
</table>