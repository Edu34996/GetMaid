@model IEnumerable<Core.Concretes.DTOs.BookingListItemDTO>

@{
    ViewData["Title"] = "My Booking Requests";
}

<h1>My Booking Requests</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success border border-success p-2 mb-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Title</th>
            <th>Location</th>
            <th>Budget</th>
            <th>Estimated Hours</th>
            <th>Start Date</th>
            <th>Status</th>
            <th>Respond</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var booking in Model)
        {
            <tr>
                <td>@booking.CustomerName</td>
                <td>@booking.Title</td>
                <td>@booking.Location</td>
                <td>@booking.Budget.ToString("0.00")</td>
                <td>@booking.EstimatedHours</td>
                <td>@booking.StartDate.ToShortDateString()</td>
                <td><strong>@booking.Status</strong></td>
                <td>
                    @if (booking.Status == "Pending")
                    {
                        <form asp-controller="Worker" asp-action="RespondToBooking" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <input type="hidden" name="confirm" value="true" />
                            <button type="submit" class="btn btn-success btn-sm">Accept</button>
                        </form>

                        <form asp-controller="Worker" asp-action="RespondToBooking" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <input type="hidden" name="confirm" value="false" />
                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">No action available</span>
                    }
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="8">You have no booking requests at this time.</td>
        </tr>
    }
    </tbody>
</table>