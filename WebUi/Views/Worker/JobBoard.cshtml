@model IEnumerable<Core.Concretes.DTOs.JobPostingCardDTO>

@{
    ViewData["Title"] = "Available Jobs";
}

<h1>Available Jobs</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success border border-success p-2 mb-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Start Date</th>
            <th>Budget</th>
            <th>Services</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Location</td>
                <td>@job.StartDate.ToShortDateString()</td>
                <td>@job.Budget.ToString("0.00")</td>
                <td>
                    @if (job.ServiceTypes != null && job.ServiceTypes.Any())
                    {
                        @foreach (var service in job.ServiceTypes)
                        {
                            <span class="badge bg-secondary me-1">@service</span>
                        }
                    }
                    else
                    {
                        <span>No services listed</span>
                    }
                </td>
                <td>
                    <form asp-controller="Worker" asp-action="ApplyForJob" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@job.Id" />
                        <button type="submit" class="btn btn-success btn-sm">
                            Apply
                        </button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="6">No open jobs available right now.</td>
        </tr>
    }
    </tbody>
</table>