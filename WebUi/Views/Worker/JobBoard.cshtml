@model IEnumerable<Core.Concretes.DTOs.JobPostingDTO>

<h1>Available Jobs</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 15px;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 15px;">
        @TempData["ErrorMessage"]
    </div>
}

<table border="1" cellpadding="5" cellspacing="0" style="width: 100%; text-align: left;">
    <thead>
    <tr>
        <th>Customer</th>
        <th>Title</th>
        <th>Location</th>
        <th>Date Needed</th>
        <th>Budget</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var job in Model)
        {
            <tr>
                <td>@job.CustomerName</td>
                <td>@job.Title<br /><small>@job.Description</small></td>
                <td>@job.Location</td>
                <td>@job.DateNeeded.ToShortDateString()</td>
                <td>$@job.Budget</td>
                <td>
                    @if (job.HasApplied)
                    {
                        <button disabled style="background-color: #6c757d; color: white; border: none; padding: 5px 10px; cursor: not-allowed; border-radius: 3px;">
                            Applied (Pending)
                        </button>
                    }
                    else
                    {
                        <form asp-controller="Worker" asp-action="ApplyForJob" method="post">
                            <input type="hidden" name="jobId" value="@job.Id" />
                            <button type="submit" style="background-color: #28a745; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px;">
                                Apply
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="6">No open jobs available right now.</td></tr>
    }
    </tbody>
</table>