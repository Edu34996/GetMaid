@model IEnumerable<Core.Concretes.DTOs.ConversationDTO>

@{
    ViewData["Title"] = "My Inbox";
}

<div class="container mt-4">
    <h2 class="mb-4">My Inbox</h2>

    <div class="list-group shadow-sm">
        @if (Model != null && Model.Any())
        {
            foreach (var convo in Model)
            {
                <a href="/Message/Chat?otherUserId=@convo.OtherUserId" class="list-group-item list-group-item-action p-3">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <h5 class="mb-1 fw-bold text-primary">@convo.OtherUserName</h5>
                        <small class="text-muted">@convo.LastMessageAt.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                    </div>
                    <p class="mb-1 text-truncate" style="max-width: 85%;">
                        @convo.LastMessage
                    </p>
                </a>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <h4>Your inbox is empty.</h4>
                <p>When you message workers or customers, your conversations will appear here.</p>
            </div>
        }
    </div>
</div>