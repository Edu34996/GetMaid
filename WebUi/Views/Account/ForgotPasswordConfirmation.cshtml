@{
    ViewData["Title"] = "Check Your Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
    .fc-wrap { max-width: 680px; margin: 48px auto; font-family: 'DM Sans', system-ui, sans-serif; padding: 0 12px; }
    .fc-shell { background: #fff; border: 1px solid #e4e8ee; border-radius: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 6px 20px rgba(0,0,0,.05); overflow: hidden; }
    .fc-head { background: linear-gradient(125deg, #0c1224 0%, #1a2744 60%, #1f3561 100%); padding: 28px 32px; display: flex; align-items: center; gap: 14px; }
    .fc-head-icon { width: 48px; height: 48px; border-radius: 12px; background: rgba(245,158,11,.18); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 1.4rem; flex-shrink: 0; }
    .fc-head-title { font-family: 'Nunito', sans-serif; font-size: 1.4rem; font-weight: 800; color: #fff; margin: 0; }
    .fc-head-sub { color: rgba(255,255,255,.75); font-size: .88rem; margin: 3px 0 0; }
    .fc-body { padding: 32px; }
    .fc-icon-wrap { text-align: center; margin-bottom: 22px; }
    .fc-check-circle { width: 72px; height: 72px; border-radius: 50%; background: #f0fdf4; border: 2px solid #bbf7d0; display: inline-flex; align-items: center; justify-content: center; color: #16a34a; font-size: 2rem; }
    .fc-title { font-family: 'Nunito', sans-serif; font-size: 1.25rem; font-weight: 800; color: #0f1e35; text-align: center; margin: 0 0 10px; }
    .fc-desc { color: #3f4d63; font-size: .92rem; line-height: 1.7; text-align: center; margin: 0 0 24px; }
    .fc-steps { background: #f8fafc; border: 1px solid #e4e8ee; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
    .fc-step { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
    .fc-step:last-child { margin-bottom: 0; }
    .fc-step-num { width: 24px; height: 24px; border-radius: 50%; background: #f59e0b; color: #fff; font-size: .75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .fc-step-text { font-size: .87rem; color: #3f4d63; line-height: 1.5; }
    .fc-step-text strong { color: #0f1e35; }
    .fc-btn { display: block; width: 100%; border: none; border-radius: 10px; padding: 11px 14px; font-weight: 700; color: #fff; background: linear-gradient(135deg, #f59e0b, #d97706); cursor: pointer; text-align: center; text-decoration: none; font-size: .95rem; }
    .fc-btn:hover { filter: brightness(1.04); color: #fff; }
    .fc-back { display: block; text-align: center; margin-top: 14px; font-size: .86rem; color: #7a8699; }
    .fc-back a { color: #1f3561; font-weight: 700; text-decoration: none; }
    .fc-back a:hover { color: #d97706; }
</style>

<div class="fc-wrap">
    <div class="fc-shell">

        <div class="fc-head">
            <div class="fc-head-icon"><i class="bi bi-envelope-fill"></i></div>
            <div>
                <h1 class="fc-head-title">Check your inbox</h1>
                <p class="fc-head-sub">Password reset instructions are on the way.</p>
            </div>
        </div>

        <div class="fc-body">
            <div class="fc-icon-wrap">
                <div class="fc-check-circle"><i class="bi bi-check-lg"></i></div>
            </div>

            <h2 class="fc-title">Email sent successfully</h2>
            <p class="fc-desc">
                If an account exists for that email address, we have sent password reset instructions.
                Please check your inbox and spam folder.
            </p>

            <div class="fc-steps">
                <div class="fc-step">
                    <span class="fc-step-num">1</span>
                    <span class="fc-step-text">Open the email from <strong>GetMaid</strong> in your inbox.</span>
                </div>
                <div class="fc-step">
                    <span class="fc-step-num">2</span>
                    <span class="fc-step-text">Click the <strong>Reset Password</strong> button inside the email.</span>
                </div>
                <div class="fc-step">
                    <span class="fc-step-num">3</span>
                    <span class="fc-step-text">Choose a new password and sign in.</span>
                </div>
            </div>

            <a asp-action="Login" class="fc-btn">Back to Sign In</a>

            <p class="fc-back">
                Didn't receive an email?
                <a asp-action="ForgotPassword">Try again</a>
            </p>
        </div>

    </div>
</div>