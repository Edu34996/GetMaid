@model Core.Concretes.DTOs.ResetPasswordDTO

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:700px;margin:28px auto;padding:22px;border:1px solid #e4e8ee;border-radius:14px;background:#fff;">
    <h2 style="margin-top:0;">Set a new password</h2>

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#dc2626;"></div>

        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div style="margin-bottom:12px;">
            <label asp-for="Password"></label><br />
            <input asp-for="Password" type="password" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;" />
            <span asp-validation-for="Password" style="color:#dc2626;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="ConfirmPassword"></label><br />
            <input asp-for="ConfirmPassword" type="password" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;" />
            <span asp-validation-for="ConfirmPassword" style="color:#dc2626;"></span>
        </div>

        <button type="submit" style="padding:10px 16px;border:none;border-radius:8px;background:#f59e0b;color:#fff;font-weight:700;">
            Reset Password
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}