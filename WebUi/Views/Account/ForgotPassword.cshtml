@model Core.Concretes.DTOs.ForgotPasswordDTO

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
    .fp-wrap { max-width: 980px; margin: 24px auto 48px; font-family: 'DM Sans', system-ui, sans-serif; padding: 0 12px; }
    .fp-shell { background:#fff; border:1px solid #e4e8ee; border-radius:16px; box-shadow:0 1px 3px rgba(0,0,0,.06), 0 6px 20px rgba(0,0,0,.05); overflow:hidden; }
    .fp-head { background:linear-gradient(125deg,#0c1224 0%,#1a2744 60%,#1f3561 100%); color:#fff; padding:24px; }
    .fp-title { font-family:'Nunito',sans-serif; font-size:1.5rem; font-weight:800; margin:0; }
    .fp-sub { opacity:.85; margin:6px 0 0; }
    .fp-body { padding:24px; max-width:520px; }
    .fp-label { display:block; font-size:.8rem; font-weight:700; color:#3f4d63; margin-bottom:6px; }
    .fp-input { width:100%; padding:10px 12px; border:1.5px solid #e4e8ee; border-radius:10px; background:#f8fafc; outline:none; }
    .fp-input:focus { border-color:#f59e0b; background:#fff; box-shadow:0 0 0 3px rgba(245,158,11,.14); }
    .fp-btn { border:none; border-radius:10px; padding:10px 16px; font-weight:700; color:#fff; background:linear-gradient(135deg,#f59e0b,#d97706); }
    .fp-error { color:#dc2626; font-size:.8rem; margin-top:4px; display:block; }
    .fp-links { margin-top:14px; font-size:.86rem; }
    .fp-links a { font-weight:700; text-decoration:none; color:#1f3561; }
</style>

<div class="fp-wrap">
    <div class="fp-shell">
        <div class="fp-head">
            <h1 class="fp-title">Reset your password</h1>
            <p class="fp-sub">Enter your account email and we will send reset instructions.</p>
        </div>

        <div class="fp-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="fp-error"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="fp-label"></label>
                    <input asp-for="Email" class="fp-input" />
                    <span asp-validation-for="Email" class="fp-error"></span>
                </div>

                <button type="submit" class="fp-btn">Send Reset Link</button>
            </form>

            <div class="fp-links">
                <a asp-action="Login">Back to Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}