@model IEnumerable<Core.Concretes.DTOs.BookingListItemDTO>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bookings = (Model ?? Enumerable.Empty<Core.Concretes.DTOs.BookingListItemDTO>()).ToList();

    // FUTURE SWITCH:
    // Once you add Customer/BookingDetails, change this to nameof(CustomerController.BookingDetails)
    // For now it points to MyBookings to avoid broken links.
    var bookingDetailsAction = "BookingDetails";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
    .mbk-wrap {
        max-width: 1120px;
        margin: 24px auto 48px;
        padding: 0 12px;
        font-family: 'DM Sans', system-ui, sans-serif;
    }

    .mbk-shell {
        background: #fff;
        border: 1px solid #e4e8ee;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 6px 20px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .mbk-head {
        background: linear-gradient(125deg, #0c1224 0%, #1a2744 60%, #1f3561 100%);
        color: #fff;
        padding: 22px 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
    }

    .mbk-title {
        margin: 0;
        font-family: 'Nunito', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .mbk-sub {
        margin: 4px 0 0;
        color: rgba(255,255,255,.82);
        font-size: .9rem;
    }

    .mbk-head-btn {
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff !important;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 8px 18px rgba(217,119,6,.2);
        transition: all .18s ease;
        white-space: nowrap;
    }

    .mbk-head-btn:hover {
        filter: brightness(1.03);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .mbk-body {
        padding: 22px;
        background: #f8fafc;
    }

    .mbk-alert-ok {
        border-radius: 12px;
        background: #f0fdf4;
        border: 1.5px solid #bbf7d0;
        color: #15803d;
        font-size: .86rem;
        padding: 10px 12px;
        margin-bottom: 12px;
    }

    .mbk-alert-err {
        border-radius: 12px;
        background: #fef2f2;
        border: 1.5px solid #fecaca;
        color: #dc2626;
        font-size: .86rem;
        padding: 10px 12px;
        margin-bottom: 12px;
    }

    .mbk-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    @@media (max-width: 991.98px) {
        .mbk-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 575.98px) {
        .mbk-stats { grid-template-columns: 1fr; }
    }

    .mbk-stat {
        background: #fff;
        border: 1px solid #e4e8ee;
        border-radius: 12px;
        padding: 12px 14px;
    }

    .mbk-stat-label {
        display: block;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #7a8699;
        margin-bottom: 4px;
    }

    .mbk-stat-val {
        font-family: 'Nunito', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f1e35;
        line-height: 1;
    }

    .mbk-table-wrap {
        background: #fff;
        border: 1px solid #e4e8ee;
        border-radius: 14px;
        overflow: hidden;
    }

    .mbk-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .mbk-table th,
    .mbk-table td {
        padding: 11px 12px;
        border-bottom: 1px solid #e4e8ee;
        text-align: left;
        vertical-align: middle;
    }

    .mbk-table th {
        font-size: .76rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #7a8699;
        font-weight: 700;
        background: #f8fafc;
    }

    .mbk-table td {
        color: #0f1e35;
        font-size: .88rem;
    }

    .mbk-worker-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #0f1e35;
        font-weight: 600;
    }

    .mbk-worker-link:hover {
        color: #d97706;
    }

    .mbk-worker-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid #e4e8ee;
        background: #f8fafc;
    }

    .mbk-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .2px;
        border: 1px solid transparent;
    }

    .mbk-status.pending {
        color: #92400e;
        background: #fffbeb;
        border-color: #fde68a;
    }

    .mbk-status.accepted,
    .mbk-status.confirmed {
        color: #166534;
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .mbk-status.rejected,
    .mbk-status.cancelled {
        color: #991b1b;
        background: #fef2f2;
        border-color: #fecaca;
    }

    .mbk-status.completed {
        color: #1e3a8a;
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .mbk-contact-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        border-radius: 9px;
        padding: 7px 10px;
        text-decoration: none;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff !important;
        font-size: .78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .mbk-contact-btn:hover {
        filter: brightness(1.03);
        transform: translateY(-1px);
    }

    .mbk-row-link {
        color: inherit;
        text-decoration: none;
        display: block;
        border-radius: 8px;
        padding: 2px 2px;
        transition: all .15s ease;
    }

    .mbk-row-link:hover {
        color: #d97706;
        background: rgba(245,158,11,.08);
    }

    .mbk-empty {
        text-align: center;
        padding: 40px 18px;
        color: #7a8699;
    }

    .mbk-empty h3 {
        font-family: 'Nunito', sans-serif;
        font-size: 1.05rem;
        color: #0f1e35;
        margin-bottom: 6px;
    }

    .mbk-empty p {
        margin: 0 0 16px;
        font-size: .9rem;
    }

    .mbk-empty a {
        display: inline-block;
        border-radius: 10px;
        padding: 10px 14px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff !important;
        font-weight: 700;
        text-decoration: none;
    }

    @@media (max-width: 991.98px) {
        .mbk-table-wrap { overflow-x: auto; }
        .mbk-table { min-width: 980px; }
    }
</style>

<div class="mbk-wrap">
    <div class="mbk-shell">
        <div class="mbk-head">
            <div>
                <h1 class="mbk-title">My Bookings</h1>
                <p class="mbk-sub">Track your worker bookings and current engagement status.</p>
            </div>
            <a asp-controller="Customer" asp-action="WorkerShop" class="mbk-head-btn">
                <i class="bi bi-search me-1"></i> Find More Workers
            </a>
        </div>

        <div class="mbk-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mbk-alert-ok">
                    <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mbk-alert-err">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="mbk-stats">
                <div class="mbk-stat">
                    <span class="mbk-stat-label">Total Bookings</span>
                    <span class="mbk-stat-val">@bookings.Count</span>
                </div>
                <div class="mbk-stat">
                    <span class="mbk-stat-label">Pending</span>
                    <span class="mbk-stat-val">@bookings.Count(b => string.Equals(b.Status, "Pending", StringComparison.OrdinalIgnoreCase))</span>
                </div>
                <div class="mbk-stat">
                    <span class="mbk-stat-label">Accepted</span>
                    <span class="mbk-stat-val">@bookings.Count(b => string.Equals(b.Status, "Accepted", StringComparison.OrdinalIgnoreCase) || string.Equals(b.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))</span>
                </div>
                <div class="mbk-stat">
                    <span class="mbk-stat-label">Completed</span>
                    <span class="mbk-stat-val">@bookings.Count(b => string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase))</span>
                </div>
            </div>

            
            @{
                var bookingTableViewData = new ViewDataDictionary(ViewData)
                {
                    ["Mode"] = "customer",
                    ["DetailsAction"] = bookingDetailsAction
                };
            }
            <partial name="~/Views/Shared/Tables/_BookingTable.cshtml" model="bookings" view-data="bookingTableViewData" />
        </div>
    </div>
</div>