@model IEnumerable<Core.Concretes.DTOs.BookingListItemDTO>

@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>
<a asp-controller="Customer" asp-action="WorkerShop" class="btn btn-primary btn-sm">Find More Workers</a>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success border border-success p-2 mb-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Title</th>
        <th>Customer Name</th>
        <th>Location</th>
        <th>Budget</th>
        <th>Estimated Hours</th>
        <th>Start Date</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Title</td>
                <td>@booking.CustomerName</td>
                <td>@booking.Location</td>
                <td>@booking.Budget.ToString("0.00")</td>
                <td>@booking.EstimatedHours</td>
                <td>@booking.StartDate.ToShortDateString()</td>
                <td>
                    <strong>@booking.Status</strong>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7">You have no booking history.</td>
        </tr>
    }
    </tbody>
</table>