@using Core.Concretes.DTOs
@using Core.Concretes.Enums
@model IEnumerable<WorkerCardDTO>

@{
    ViewData["Title"] = "Worker Shop";
    var currentFilter = ViewBag.CurrentFilter as WorkerSearchFilterDTO ?? new WorkerSearchFilterDTO();
}

<h1>Find a Worker</h1>
<hr />

<div class="border rounded p-3 mb-4 bg-light">
    <h3>Filter Workers</h3>

    <form asp-controller="Customer" asp-action="WorkerShop" method="get">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label>City</label>
                <input type="text" name="City" value="@currentFilter.City" class="form-control" placeholder="Enter city" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Minimum Hourly Rate</label>
                <input type="number" step="0.01" name="MinHourlyRate" value="@currentFilter.MinHourlyRate" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Maximum Hourly Rate</label>
                <input type="number" step="0.01" name="MaxHourlyRate" value="@currentFilter.MaxHourlyRate" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Minimum Experience Years</label>
                <input type="number" name="MinExperienceYears" value="@currentFilter.MinExperienceYears" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Minimum Average Rating</label>
                <input type="number" step="0.1" min="0" max="5" name="MinAverageRating" value="@currentFilter.MinAverageRating" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Preferred Arrangement</label>
                <select name="PreferredArrangement" class="form-select">
                    <option value="">-- Any --</option>
                    @foreach (WorkArrangement arrangement in Enum.GetValues(typeof(WorkArrangement)))
                    {
                        <option value="@arrangement" selected="@(currentFilter.PreferredArrangement == arrangement)">
                            @arrangement
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label>Commitment Preference</label>
                <select name="CommitmentPreference" class="form-select">
                    <option value="">-- Any --</option>
                    @foreach (CommitmentPreference commitment in Enum.GetValues(typeof(CommitmentPreference)))
                    {
                        <option value="@commitment" selected="@(currentFilter.CommitmentPreference == commitment)">
                            @commitment
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="me-3">
                <input type="checkbox" name="NonSmokerOnly" value="true" @(currentFilter.NonSmokerOnly == true ? "checked" : "") />
                Non-smoker only
            </label>

            <label>
                <input type="checkbox" name="VerifiedOnly" value="true" @(currentFilter.VerifiedOnly == true ? "checked" : "") />
                Verified workers only
            </label>
        </div>

        <div class="mb-3">
            <label>Required Services</label>
            <div class="border rounded p-2">
                @foreach (ServiceType service in Enum.GetValues(typeof(ServiceType)))
                {
                    <label class="me-3">
                        <input type="checkbox"
                               name="RequiredServices"
                               value="@service"
                               @(currentFilter.RequiredServices.Contains(service) ? "checked" : "") />
                        @service
                    </label>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-controller="Customer" asp-action="WorkerShop" class="btn btn-outline-secondary ms-2">Clear Filters</a>
    </form>
</div>

<h3>Available Workers</h3>

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger mb-3">@TempData["ErrorMessage"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var worker in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="border rounded p-3 h-100">
                    <div class="mb-2">
                        <strong>@worker.FirstName</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(worker.ProfilePictureUrl))
                    {
                        <div class="mb-2">
                            <img src="@worker.ProfilePictureUrl" alt="@worker.FirstName" style="max-width:100%; max-height:180px; object-fit:cover;" />
                        </div>
                    }

                    <div><strong>City:</strong> @worker.City</div>
                    <div><strong>Smoker:</strong> @(worker.IsSmoker ? "Yes" : "No")</div>
                    <div><strong>Min Rate:</strong> @(worker.MinHourlyRate?.ToString("0.00") ?? "-")</div>
                    <div><strong>Max Rate:</strong> @(worker.MaxHourlyRate?.ToString("0.00") ?? "-")</div>
                    <div><strong>Average Rate:</strong> @(worker.AverageHourlyRate?.ToString("0.00") ?? "-")</div>
                    <div><strong>Rating:</strong> @worker.AverageRating (@worker.TotalReviews reviews)</div>
                    <div><strong>Skills:</strong> @worker.NumberOfSkills</div>
                    <div><strong>Languages:</strong> @worker.NumberOfLanguages</div>

                    <div class="mt-2">
                        <strong>Services:</strong><br />
                        @if (worker.OfferedServices != null && worker.OfferedServices.Any())
                        {
                            @foreach (var service in worker.OfferedServices)
                            {
                                <span class="badge bg-secondary me-1">@service</span>
                            }
                        }
                        else
                        {
                            <span>No services listed</span>
                        }
                    </div>

                    <div class="mt-3">
                        <a asp-controller="Customer" asp-action="WorkerDetails" asp-route-workerId="@worker.Id"
                           class="btn btn-outline-primary btn-sm">
                            View Details
                        </a>

                        <a asp-controller="Customer" asp-action="BookWorker" asp-route-workerId="@worker.Id"
                           class="btn btn-success btn-sm">
                            Book Worker
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div>No workers match your current filters. Try adjusting your search.</div>
}