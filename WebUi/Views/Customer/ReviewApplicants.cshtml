@using Core.Concretes.DTOs
@using Core.Concretes.Enums
@model IEnumerable<JobApplicationDTO>

@{
    ViewData["Title"] = "Review Applicants";
}

<h1>Review Applicants</h1>
<a asp-controller="Customer" asp-action="MyJobs" class="btn btn-secondary btn-sm">Back to My Jobs</a>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Worker Name</th>
            <th>Worker Bio</th>
            <th>Min Rate</th>
            <th>Max Rate</th>
            <th>Message</th>
            <th>Soonest Start</th>
            <th>Currently Working</th>
            <th>Questions</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var app in Model)
        {
            <tr>
                <td><strong>@app.WorkerName</strong></td>
                <td>@app.WorkerBio</td>
                <td>@(app.WorkerMinHourlyRate?.ToString("0.00") ?? "-")</td>
                <td>@(app.WorkerMaxHourlyRate?.ToString("0.00") ?? "-")</td>
                <td>@app.MessageToCustomer</td>
                <td>@(app.SoonestAvailableStartDate?.ToShortDateString() ?? "-")</td>
                <td>@(app.IsCurrentlyWorking ? "Yes" : "No")</td>
                <td>@app.QuestionsAboutWork</td>
                <td>@app.Status</td>
                <td>
                    @if (app.Status == ApplicationStatus.Pending)
                    {
                        <form asp-controller="Customer" asp-action="HireWorker" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@app.Id" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Hire Worker
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted"><em>@app.Status</em></span>
                    }
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="10">No workers have applied for this job yet. Check back soon!</td>
        </tr>
    }
    </tbody>
</table>