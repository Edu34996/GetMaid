@model IEnumerable<Core.Concretes.DTOs.JobPostingDTO>

<h1>My Job Postings</h1>
<a href="/Customer/CreateJob">Post a New Job</a>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 15px;">
        @TempData["SuccessMessage"]
    </div>
}

<table border="1" cellpadding="5" cellspacing="0" style="width: 100%; text-align: left;">
    <thead>
    <tr>
        <th>Title</th>
        <th>Location</th>
        <th>Date Needed</th>
        <th>Budget</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Location</td>
                <td>@job.DateNeeded.ToShortDateString()</td>
                <td>$@job.Budget</td>
                <td>
                    @if (job.Status == "Open")
                    {
                        <a href="/Customer/ReviewApplicants?jobId=@job.Id" 
                           style="background-color: #17a2b8; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px;">
                            Review Applicants
                        </a>
                    }
                    else
                    {
                        <strong>@job.Status</strong>
                    }
                </td>            </tr>
        }
    }
    else
    {
        <tr><td colspan="5">You haven't posted any jobs yet.</td></tr>
    }
    </tbody>
</table>