@using Core.Concretes.DTOs
@model IEnumerable<JobPostingCardDTO>

@{
    ViewData["Title"] = "My Job Postings";
}

<h1>My Job Postings</h1>
<a asp-controller="Customer" asp-action="CreateJob" class="btn btn-primary btn-sm">Post a New Job</a>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="text-success border border-success p-2 mb-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger border border-danger p-2 mb-3">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Title</th>
        <th>Location</th>
        <th>Start Date</th>
        <th>Budget</th>
        <th>Services</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Location</td>
                <td>@job.StartDate.ToShortDateString()</td>
                <td>@job.Budget.ToString("0.00")</td>
                <td>
                    @if (job.ServiceTypes != null && job.ServiceTypes.Any())
                    {
                        @foreach (var service in job.ServiceTypes)
                        {
                            <span class="badge bg-secondary me-1">@service</span>
                        }
                    }
                </td>
                <td>
                    <a asp-controller="Customer" asp-action="ReviewApplicants" asp-route-jobId="@job.Id"
                       class="btn btn-info btn-sm text-white">
                        Review Applicants
                    </a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="6">You haven't posted any jobs yet.</td>
        </tr>
    }
    </tbody>
</table>